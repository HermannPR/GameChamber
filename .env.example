# GAMECHAMBER Environment Configuration
# Copy this file to .env and fill in your API keys

# Server Configuration
PORT=3001

# Gemini API Configuration (Primary AI)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Claude API Configuration (Fallback AI)
# Get your API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Note: You need at least one API key configured for the app to work
# Both can be configured for redundancy (Gemini primary, Claude fallback)
