{
  "name": "dreamexplorer",
  "version": "0.1.0",
  "description": "AI-generated immersive 3D emotional experiences",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "keywords": [
    "3d",
    "threejs",
    "procedural-generation",
    "meditation",
    "mental-health",
    "emotional-experiences",
    "dreams"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0",
    "@iarna/toml": "^2.2.5",
    "localforage": "^1.10.0",
    "simplex-noise": "^4.0.1",
    "poisson-disk-sampling": "^2.0.0",
    "tone": "^14.8.49"
  },
  "devDependencies": {
    "vite": "^5.0.0",
    "typescript": "^5.3.0",
    "@types/three": "^0.160.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0"
  }
}
